<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:DeployHysteria.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="600"
             x:Class="DeployHysteria.UI.Views.QrCodeDialogView"
             x:DataType="vm:QrCodeDialogViewModel"
             IsVisible="{Binding IsOpen, FallbackValue=False}">

    <UserControl.Styles>
        <Style Selector="Border.DialogCard">
            <Setter Property="Padding" Value="24" />
        </Style>
        <Style Selector=":is(UserControl).compact Border.DialogCard">
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style Selector="Image.QrImage">
            <Setter Property="Width" Value="200" />
            <Setter Property="Height" Value="200" />
        </Style>
        <Style Selector=":is(UserControl).compact Image.QrImage">
            <Setter Property="Width" Value="176" />
            <Setter Property="Height" Value="176" />
        </Style>

        <Style Selector="Button.QrAction0">
            <Setter Property="Grid.Row" Value="0" />
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.ColumnSpan" Value="1" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
        <Style Selector=":is(UserControl).compact Button.QrAction0">
            <Setter Property="Grid.Row" Value="0" />
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.ColumnSpan" Value="3" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style Selector="Button.QrAction1">
            <Setter Property="Grid.Row" Value="0" />
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Grid.ColumnSpan" Value="1" />
            <Setter Property="Margin" Value="4,0,4,0" />
        </Style>
        <Style Selector=":is(UserControl).compact Button.QrAction1">
            <Setter Property="Grid.Row" Value="1" />
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.ColumnSpan" Value="3" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style Selector="Button.QrAction2">
            <Setter Property="Grid.Row" Value="0" />
            <Setter Property="Grid.Column" Value="2" />
            <Setter Property="Grid.ColumnSpan" Value="1" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>
        <Style Selector=":is(UserControl).compact Button.QrAction2">
            <Setter Property="Grid.Row" Value="2" />
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.ColumnSpan" Value="3" />
            <Setter Property="Margin" Value="0" />
        </Style>
    </UserControl.Styles>

    <Grid>
        <!-- Backdrop dim -->
        <Border Background="#99000000" />

        <!-- Scrollable Dialog Container -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="16">
            <!-- Dialog Card -->
            <Border Classes="Card DialogCard"
                    MaxWidth="480"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    CornerRadius="12"
                    Margin="0"
                    BoxShadow="0 8 32 0 #44000000">

                <StackPanel Spacing="16">
                    <!-- Header -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,8,0">
                            <TextBlock Text="{Binding Loc[DialogTitleQr]}"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Username, StringFormat='{}User: {0}'}"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Classes="Secondary"
                                Content="✕"
                                Padding="8,4"
                                VerticalAlignment="Top"
                                Command="{Binding CloseCommand}" />
                    </Grid>

                    <Separator Margin="0,-4,0,0" />

                    <!-- QR Code Image -->
                    <Border Background="White"
                            CornerRadius="8"
                            Padding="12"
                            HorizontalAlignment="Center"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1">
                        <Image Classes="QrImage"
                               Source="{Binding QrBitmap}"
                               Stretch="Uniform" />
                    </Border>

                    <!-- URI box -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="URI Link:"
                                   Classes="FieldLabel" />
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Text="{Binding Uri}"
                                     IsReadOnly="True"
                                     CornerRadius="6,0,0,6"
                                     FontSize="11" />
                            <Button Grid.Column="1"
                                    Classes="Primary"
                                    CornerRadius="0,6,6,0"
                                    Content="📋"
                                    ToolTip.Tip="{Binding Loc[CopyLinkButton]}"
                                    Command="{Binding CopyUriCommand}" />
                        </Grid>
                    </StackPanel>

                    <!-- Actions -->
                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto">
                        <Button Classes="Secondary QrAction0"
                                HorizontalAlignment="Stretch"
                                Command="{Binding CopyUriCommand}">
                            <TextBlock Text="{Binding Loc[CopyLinkButton]}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" />
                        </Button>

                        <Button Classes="Secondary QrAction1"
                                HorizontalAlignment="Stretch"
                                Command="{Binding SaveQrImageCommand}">
                            <TextBlock Text="{Binding Loc[SaveQrImageButton]}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" />
                        </Button>

                        <Button Classes="Secondary QrAction2"
                                HorizontalAlignment="Stretch"
                                Command="{Binding ExportTextConfigCommand}">
                            <TextBlock Text="{Binding Loc[ExportTxtButton]}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" />
                        </Button>
                    </Grid>

                    <!-- Notification Alert -->
                    <Border IsVisible="{Binding NotificationMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            Classes="BadgeSuccess"
                            HorizontalAlignment="Center">
                        <TextBlock Text="{Binding NotificationMessage}"
                                   Foreground="#107C41"
                                   FontWeight="Medium"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center" />
                    </Border>

                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>

</UserControl>
