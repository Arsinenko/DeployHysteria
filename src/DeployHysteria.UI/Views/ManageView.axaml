<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:DeployHysteria.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="1000"
             x:Class="DeployHysteria.UI.Views.ManageView"
             x:DataType="vm:ManageViewModel">

    <UserControl.Styles>
        <Style Selector="StackPanel.PrimaryField">
            <Setter Property="Grid.Row" Value="0" />
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.ColumnSpan" Value="1" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style Selector=":is(UserControl).compact StackPanel.PrimaryField">
            <Setter Property="Grid.ColumnSpan" Value="2" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style Selector="StackPanel.PortField">
            <Setter Property="Grid.Row" Value="0" />
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Grid.ColumnSpan" Value="1" />
            <Setter Property="MinWidth" Value="110" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector=":is(UserControl).compact StackPanel.PortField">
            <Setter Property="Grid.Row" Value="1" />
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.ColumnSpan" Value="2" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>

        <Style Selector="StackPanel.ServerInfoHeader">
            <Setter Property="Grid.Row" Value="0" />
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.ColumnSpan" Value="1" />
        </Style>
        <Style Selector=":is(UserControl).compact StackPanel.ServerInfoHeader">
            <Setter Property="Grid.ColumnSpan" Value="2" />
        </Style>

        <Style Selector="WrapPanel.ServerActions">
            <Setter Property="Grid.Row" Value="0" />
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Grid.ColumnSpan" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="12,0,0,0" />
        </Style>
        <Style Selector=":is(UserControl).compact WrapPanel.ServerActions">
            <Setter Property="Grid.Row" Value="1" />
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.ColumnSpan" Value="2" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>

        <Style Selector="StackPanel.HealthCol0">
            <Setter Property="Grid.Row" Value="0" />
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.ColumnSpan" Value="1" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style Selector=":is(UserControl).compact StackPanel.HealthCol0">
            <Setter Property="Grid.ColumnSpan" Value="3" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style Selector="StackPanel.HealthCol1">
            <Setter Property="Grid.Row" Value="0" />
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Grid.ColumnSpan" Value="1" />
            <Setter Property="Margin" Value="4,0,4,0" />
        </Style>
        <Style Selector=":is(UserControl).compact StackPanel.HealthCol1">
            <Setter Property="Grid.Row" Value="1" />
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.ColumnSpan" Value="3" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style Selector="StackPanel.HealthCol2">
            <Setter Property="Grid.Row" Value="0" />
            <Setter Property="Grid.Column" Value="2" />
            <Setter Property="Grid.ColumnSpan" Value="1" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
        <Style Selector=":is(UserControl).compact StackPanel.HealthCol2">
            <Setter Property="Grid.Row" Value="2" />
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.ColumnSpan" Value="3" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style Selector="TextBox.AddUserName">
            <Setter Property="Grid.Row" Value="0" />
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.ColumnSpan" Value="1" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style Selector=":is(UserControl).compact TextBox.AddUserName">
            <Setter Property="Grid.ColumnSpan" Value="4" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style Selector="TextBox.AddUserPass">
            <Setter Property="Grid.Row" Value="0" />
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Grid.ColumnSpan" Value="1" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style Selector=":is(UserControl).compact TextBox.AddUserPass">
            <Setter Property="Grid.Row" Value="1" />
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.ColumnSpan" Value="3" />
            <Setter Property="Margin" Value="0,0,6,8" />
        </Style>

        <Style Selector="Button.AddUserGen">
            <Setter Property="Grid.Row" Value="0" />
            <Setter Property="Grid.Column" Value="2" />
            <Setter Property="Grid.ColumnSpan" Value="1" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style Selector=":is(UserControl).compact Button.AddUserGen">
            <Setter Property="Grid.Row" Value="1" />
            <Setter Property="Grid.Column" Value="3" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style Selector="Button.AddUserSubmit">
            <Setter Property="Grid.Row" Value="0" />
            <Setter Property="Grid.Column" Value="3" />
            <Setter Property="Grid.ColumnSpan" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector=":is(UserControl).compact Button.AddUserSubmit">
            <Setter Property="Grid.Row" Value="2" />
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.ColumnSpan" Value="4" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style Selector="StackPanel.UserItemInfo">
            <Setter Property="Grid.Row" Value="0" />
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Grid.ColumnSpan" Value="1" />
        </Style>
        <Style Selector=":is(UserControl).compact StackPanel.UserItemInfo">
            <Setter Property="Grid.ColumnSpan" Value="3" />
        </Style>

        <Style Selector="Button.UserItemQr">
            <Setter Property="Grid.Row" Value="0" />
            <Setter Property="Grid.Column" Value="2" />
            <Setter Property="Grid.ColumnSpan" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style Selector=":is(UserControl).compact Button.UserItemQr">
            <Setter Property="Grid.Row" Value="1" />
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Grid.ColumnSpan" Value="2" />
            <Setter Property="Margin" Value="0,8,8,0" />
        </Style>

        <Style Selector="Button.UserItemDelete">
            <Setter Property="Grid.Row" Value="0" />
            <Setter Property="Grid.Column" Value="3" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector=":is(UserControl).compact Button.UserItemDelete">
            <Setter Property="Grid.Row" Value="1" />
            <Setter Property="Grid.Column" Value="3" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Classes="PageContainer" MaxWidth="820">

            <!-- Error Banner -->
            <Border IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    Classes="BadgeDanger"
                    Padding="12,8">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#E81123"
                           TextWrapping="Wrap" />
            </Border>

            <!-- Status Banner -->
            <Border IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    Classes="BadgeSuccess"
                    Padding="12,8">
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="#107C41"
                           TextWrapping="Wrap" />
            </Border>

            <!-- 1. Connection Card (shown when NOT connected) -->
            <Border Classes="Card" IsVisible="{Binding !IsConnected}">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding Loc[ServerConnectionTitle]}" Classes="CardTitle" />

                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                        <StackPanel Classes="PrimaryField">
                            <TextBlock Text="{Binding Loc[HostLabel]}" Classes="FieldLabel" />
                            <TextBox Text="{Binding Host}"
                                     PlaceholderText="{Binding Loc[HostWatermark]}"
                                     ToolTip.Tip="{Binding Loc[HostTooltip]}" />
                        </StackPanel>

                        <StackPanel Classes="PortField">
                            <TextBlock Text="{Binding Loc[SshPortLabel]}" Classes="FieldLabel" />
                            <NumericUpDown Value="{Binding SshPort}"
                                           Minimum="1" Maximum="65535"
                                           FormatString="0"
                                           ToolTip.Tip="{Binding Loc[SshPortTooltip]}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel>
                        <TextBlock Text="{Binding Loc[UsernameLabel]}" Classes="FieldLabel" />
                        <TextBox Text="{Binding Username}"
                                 PlaceholderText="{Binding Loc[UsernameWatermark]}"
                                 ToolTip.Tip="{Binding Loc[UsernameTooltip]}" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding Loc[AuthTypeLabel]}" Classes="FieldLabel" />
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <RadioButton GroupName="ManageAuthMethod"
                                         Content="{Binding Loc[AuthTypePassword]}"
                                         IsChecked="{Binding IsPasswordAuth, Mode=OneWay}"
                                         Command="{Binding SelectPasswordAuthCommand}" />
                            <RadioButton GroupName="ManageAuthMethod"
                                         Content="{Binding Loc[AuthTypeKey]}"
                                         IsChecked="{Binding IsKeyAuth, Mode=OneWay}"
                                         Command="{Binding SelectKeyAuthCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsPasswordAuth}">
                        <TextBlock Text="{Binding Loc[PasswordLabel]}" Classes="FieldLabel" />
                        <TextBox Text="{Binding Password}"
                                 PasswordChar="●"
                                 PlaceholderText="{Binding Loc[PasswordWatermark]}"
                                 ToolTip.Tip="{Binding Loc[PasswordTooltip]}" />
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsKeyAuth}">
                        <TextBlock Text="{Binding Loc[SshKeyLabel]}" Classes="FieldLabel" />
                        <TextBox Text="{Binding SshPrivateKey}"
                                 AcceptsReturn="True"
                                 Height="80"
                                 PlaceholderText="{Binding Loc[SshKeyWatermark]}"
                                 ToolTip.Tip="{Binding Loc[SshKeyTooltip]}" />
                    </StackPanel>

                    <Button Classes="Primary"
                            HorizontalAlignment="Stretch"
                            MinHeight="40"
                            Margin="0,8,0,0"
                            IsEnabled="{Binding !IsLoading}"
                            Command="{Binding ConnectCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="🔗" />
                            <TextBlock Text="{Binding Loc[ConnectButton]}" IsVisible="{Binding !IsLoading}" />
                            <TextBlock Text="{Binding Loc[ConnectingButton]}" IsVisible="{Binding IsLoading}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- 2. Connected View -->
            <StackPanel IsVisible="{Binding IsConnected}" Spacing="14">

                <!-- Server Overview Status Card -->
                <Border Classes="Card">
                    <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <StackPanel Classes="ServerInfoHeader" Spacing="4">
                                <TextBlock Text="{Binding Host, StringFormat='{}Server: {0}'}"
                                           FontSize="16" FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource PrimaryTextBrush}" />
                                <TextBlock Text="{Binding RemoteDirectory, StringFormat='{}Path: {0}'}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                            </StackPanel>

                            <WrapPanel Classes="ServerActions" Orientation="Horizontal">
                                <Button Classes="Secondary"
                                        Margin="0,0,8,6"
                                        Content="{Binding Loc[RefreshStatusButton]}"
                                        Command="{Binding RefreshStatusCommand}" />
                                <Button Classes="Secondary"
                                        Margin="0,0,8,6"
                                        Content="{Binding Loc[RestartServiceButton]}"
                                        Command="{Binding RestartServiceCommand}" />
                                <Button Classes="Secondary"
                                        Margin="0,0,0,6"
                                        Content="{Binding Loc[DisconnectButton]}"
                                        Command="{Binding DisconnectCommand}" />
                            </WrapPanel>
                        </Grid>

                        <Separator Margin="0,-4,0,0" />

                        <!-- Summary & Expand Toggle Row -->
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Border Classes="BadgeSuccess"
                                        IsVisible="{Binding ContainerRunning}">
                                    <TextBlock Text="{Binding Loc[StatusRunning]}" Foreground="#107C41" FontWeight="Medium" FontSize="12" />
                                </Border>
                                <Border Classes="BadgeDanger"
                                        IsVisible="{Binding !ContainerRunning}">
                                    <TextBlock Text="{Binding Loc[StatusStopped]}" Foreground="#E81123" FontWeight="Medium" FontSize="12" />
                                </Border>
                            </StackPanel>

                            <Button Grid.Column="2"
                                    Classes="Secondary"
                                    Padding="10,4"
                                    MinHeight="28"
                                    Command="{Binding ToggleStatusExpandedCommand}">
                                <Panel>
                                    <TextBlock Text="{Binding Loc[ShowStatusDetailsButton]}"
                                               FontSize="12"
                                               IsVisible="{Binding !IsStatusExpanded}" />
                                    <TextBlock Text="{Binding Loc[HideStatusDetailsButton]}"
                                               FontSize="12"
                                               IsVisible="{Binding IsStatusExpanded}" />
                                </Panel>
                            </Button>
                        </Grid>

                        <!-- Collapsible Health indicators -->
                        <Grid IsVisible="{Binding IsStatusExpanded}"
                              ColumnDefinitions="*,*,*"
                              RowDefinitions="Auto,Auto,Auto">
                            <!-- Container status -->
                            <StackPanel Classes="HealthCol0" Spacing="4">
                                <TextBlock Text="{Binding Loc[ContainerStatusLabel]}" Classes="FieldLabel" />
                                <Border Classes="BadgeSuccess"
                                        IsVisible="{Binding ContainerRunning}"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Loc[StatusRunning]}" Foreground="#107C41" FontWeight="Medium" FontSize="12" />
                                </Border>
                                <Border Classes="BadgeDanger"
                                        IsVisible="{Binding !ContainerRunning}"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Loc[StatusStopped]}" Foreground="#E81123" FontWeight="Medium" FontSize="12" />
                                </Border>
                            </StackPanel>

                            <!-- UFW Status -->
                            <StackPanel Classes="HealthCol1" Spacing="4">
                                <TextBlock Text="{Binding Loc[UfwStatusLabel]}" Classes="FieldLabel" />
                                <TextBlock Text="{Binding UfwStatusText}"
                                           FontSize="12"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- Fail2Ban Status -->
                            <StackPanel Classes="HealthCol2" Spacing="4">
                                <TextBlock Text="{Binding Loc[Fail2BanStatusLabel]}" Classes="FieldLabel" />
                                <TextBlock Text="{Binding Fail2BanStatusText}"
                                           FontSize="12"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Users Management Card -->
                <Border Classes="Card">
                    <StackPanel Spacing="14">
                        <TextBlock Text="{Binding Loc[UsersSectionTitle]}" Classes="CardTitle" />

                        <!-- Add User Form -->
                        <Border Background="{DynamicResource SubtleFillBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{Binding Loc[AddUserButton]}" FontWeight="SemiBold" FontSize="13" />

                                <Grid ColumnDefinitions="*,*,Auto,Auto" RowDefinitions="Auto,Auto,Auto">
                                    <TextBox Classes="AddUserName"
                                             Text="{Binding NewUsername}"
                                             PlaceholderText="{Binding Loc[NewUsernameWatermark]}" />

                                    <TextBox Classes="AddUserPass"
                                             Text="{Binding NewUserPassword}"
                                             PlaceholderText="{Binding Loc[NewUserPasswordWatermark]}" />

                                    <Button Classes="Secondary AddUserGen"
                                            Content="🎲"
                                            ToolTip.Tip="{Binding Loc[GenerateButton]}"
                                            Command="{Binding GenerateNewUserPasswordCommand}" />

                                    <Button Classes="Primary AddUserSubmit"
                                            Content="{Binding Loc[AddUserButton]}"
                                            Command="{Binding AddUserCommand}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Users List -->
                        <ItemsControl ItemsSource="{Binding Users}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8"
                                            Padding="12,10"
                                            Background="{DynamicResource SubtleFillBrush}"
                                            BorderBrush="{DynamicResource CardBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto">
                                            <TextBlock Grid.Row="0" Grid.Column="0"
                                                       Text="👤"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,10,0" />

                                            <StackPanel Classes="UserItemInfo" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Username}"
                                                           FontWeight="SemiBold"
                                                           FontSize="14"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource PrimaryTextBrush}" />
                                                <TextBlock Text="••••••••••••"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                            </StackPanel>

                                            <!-- Show QR / Link button -->
                                            <Button Classes="Secondary UserItemQr"
                                                    Command="{Binding ShowQrCommand}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="📱" />
                                                    <TextBlock Text="QR &amp; Link" />
                                                </StackPanel>
                                            </Button>

                                            <!-- Delete User button -->
                                            <Button Classes="Danger UserItemDelete"
                                                    Command="{Binding DeleteCommand}"
                                                    Content="🗑️" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </Border>

                <!-- Logs Card -->
                <Border Classes="Card">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding Loc[ContainerLogsTitle]}"
                                       Classes="CardTitle"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <Button Grid.Column="1"
                                    Classes="Secondary"
                                    Content="{Binding Loc[RefreshLogsButton]}"
                                    Command="{Binding RefreshLogsCommand}" />
                        </Grid>

                        <Border Background="{DynamicResource SubtleFillBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10"
                                Height="200">
                            <ScrollViewer>
                                <TextBox Text="{Binding ContainerLogs}"
                                         IsReadOnly="True"
                                         FontFamily="Consolas,Menlo,Monospace"
                                         FontSize="11"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>

        </StackPanel>
    </ScrollViewer>

</UserControl>
