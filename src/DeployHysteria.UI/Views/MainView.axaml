<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:DeployHysteria.UI.ViewModels"
             xmlns:views="using:DeployHysteria.UI.Views"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="DeployHysteria.UI.Views.MainView"
             x:DataType="vm:MainViewModel">

    <Grid RowDefinitions="Auto,*">

        <!-- Top Header Navigation -->
        <Border Grid.Row="0"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,12">
            <Grid ColumnDefinitions="Auto,*,Auto">

                <!-- Logo & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="⚡" FontSize="20" VerticalAlignment="Center" />
                    <StackPanel Spacing="0">
                        <TextBlock Text="{Binding Loc[AppTitle]}"
                                   FontWeight="Bold"
                                   FontSize="16" />
                        <TextBlock Text="{Binding Loc[AppSubtitle]}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Navigation Tabs -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="8">
                    <Button Classes="Secondary"
                            CornerRadius="20"
                            Padding="16,6"
                            Command="{Binding SetDeployTabCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="🚀" />
                            <TextBlock Text="{Binding Loc[TabDeploy]}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <Button Classes="Secondary"
                            CornerRadius="20"
                            Padding="16,6"
                            Command="{Binding SetManageTabCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="⚙️" />
                            <TextBlock Text="{Binding Loc[TabManage]}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Right Tools (Language Switcher) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="Secondary"
                            CornerRadius="16"
                            Padding="10,4"
                            ToolTip.Tip="Switch Language (RU / EN)"
                            Command="{Binding ToggleLanguageCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="🌐" />
                            <TextBlock Text="{Binding CurrentLanguageCode}" FontWeight="Bold" FontSize="12" />
                        </StackPanel>
                    </Button>
                </StackPanel>

            </Grid>
        </Border>

        <!-- Main Tab Content -->
        <Panel Grid.Row="1">
            <!-- Deploy Tab -->
            <views:DeployView DataContext="{Binding Deploy}"
                              IsVisible="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).SelectedTabIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=0}" />

            <!-- Manage Tab -->
            <views:ManageView DataContext="{Binding Manage}"
                              IsVisible="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).SelectedTabIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=1}" />

            <!-- Modal QR Dialog -->
            <views:QrCodeDialogView DataContext="{Binding ActiveQrDialog}" />
        </Panel>

    </Grid>

</UserControl>
