<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:DeployHysteria.UI.ViewModels"
             xmlns:views="using:DeployHysteria.UI.Views"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="DeployHysteria.UI.Views.MainView"
             x:DataType="vm:MainViewModel">

    <UserControl.Styles>
        <Style Selector="Border.AppHeader">
            <Setter Property="Padding" Value="16,12" />
        </Style>
        <Style Selector=":is(UserControl).compact Border.AppHeader">
            <Setter Property="Padding" Value="12,10" />
        </Style>

        <Style Selector="StackPanel.HeaderBrand">
            <Setter Property="Grid.Row" Value="0" />
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.ColumnSpan" Value="1" />
        </Style>
        <Style Selector=":is(UserControl).compact StackPanel.HeaderBrand">
            <Setter Property="Grid.ColumnSpan" Value="2" />
        </Style>

        <Style Selector="Grid.HeaderTabs">
            <Setter Property="Grid.Row" Value="0" />
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Grid.ColumnSpan" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="12,0" />
        </Style>
        <Style Selector=":is(UserControl).compact Grid.HeaderTabs">
            <Setter Property="Grid.Row" Value="1" />
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.ColumnSpan" Value="3" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>

        <Style Selector=":is(UserControl).compact Button.TabButton">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*" Background="{DynamicResource AppBackgroundBrush}">

        <!-- Top Header Navigation -->
        <Border Grid.Row="0"
                Classes="AppHeader"
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto">

                <!-- Logo & Title -->
                <StackPanel Classes="HeaderBrand"
                            Orientation="Horizontal"
                            Spacing="10"
                            VerticalAlignment="Center">
                    <TextBlock Text="⚡" FontSize="20" VerticalAlignment="Center" />
                    <StackPanel Spacing="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Loc[AppTitle]}"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                        <TextBlock Text="{Binding Loc[AppSubtitle]}"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Navigation Tabs -->
                <Grid Classes="HeaderTabs"
                      ColumnDefinitions="*,*"
                      VerticalAlignment="Center">
                    <Button Grid.Column="0"
                            Classes="TabButton"
                            Classes.Active="{Binding IsDeployTabSelected}"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,4,0"
                            Command="{Binding SetDeployTabCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                            <TextBlock Text="🚀" />
                            <TextBlock Text="{Binding Loc[TabDeploy]}"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="1"
                            Classes="TabButton"
                            Classes.Active="{Binding IsManageTabSelected}"
                            HorizontalAlignment="Stretch"
                            Margin="4,0,0,0"
                            Command="{Binding SetManageTabCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                            <TextBlock Text="⚙️" />
                            <TextBlock Text="{Binding Loc[TabManage]}"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Right Tools (Language Switcher) -->
                <StackPanel Grid.Row="0" Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"
                            Margin="8,0,0,0">
                    <Button Classes="Secondary"
                            CornerRadius="16"
                            Padding="10,4"
                            ToolTip.Tip="Switch Language (RU / EN)"
                            Command="{Binding ToggleLanguageCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="🌐" />
                            <TextBlock Text="{Binding CurrentLanguageCode}" FontWeight="Bold" FontSize="12" />
                        </StackPanel>
                    </Button>
                </StackPanel>

            </Grid>
        </Border>

        <!-- Main Tab Content -->
        <Panel Grid.Row="1">
            <!-- Deploy Tab -->
            <Panel IsVisible="{Binding IsDeployTabSelected}">
                <views:DeployView DataContext="{Binding Deploy}" />
            </Panel>

            <!-- Manage Tab -->
            <Panel IsVisible="{Binding IsManageTabSelected}">
                <views:ManageView DataContext="{Binding Manage}" />
            </Panel>

            <!-- Modal QR Dialog -->
            <Panel IsVisible="{Binding HasActiveQrDialog}">
                <views:QrCodeDialogView DataContext="{Binding ActiveQrDialog}" />
            </Panel>
        </Panel>

    </Grid>

</UserControl>
