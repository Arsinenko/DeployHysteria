<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:DeployHysteria.UI"
             x:Class="DeployHysteria.UI.App"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F4F6" />
                    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#E2E8F0" />
                    <SolidColorBrush x:Key="SubtleFillBrush" Color="#F8FAFC" />
                    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#0F172A" />
                    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#475569" />
                    <SolidColorBrush x:Key="TertiaryTextBrush" Color="#64748B" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
                    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D4ED8" />
                    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0F1117" />
                    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#161922" />
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1A1D27" />
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#2A2F3D" />
                    <SolidColorBrush x:Key="SubtleFillBrush" Color="#13161F" />
                    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F1F5F9" />
                    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#94A3B8" />
                    <SolidColorBrush x:Key="TertiaryTextBrush" Color="#64748B" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6" />
                    <SolidColorBrush x:Key="AccentHoverBrush" Color="#2563EB" />
                    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://DeployHysteria.UI/Styles/AppStyles.axaml" />
    </Application.Styles>
</Application>
